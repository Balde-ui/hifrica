# Copier en .env sur le serveur (jamais commité) puis remplir.
ROOT_DOMAIN=hifrica.site
APP_DOMAIN=app.hifrica.site
SIM_DOMAIN=sim.hifrica.site

POSTGRES_USER=hifrica
POSTGRES_PASSWORD=change-moi-mot-de-passe-long
POSTGRES_DB=hifrica

# Assistant IA (clés uniquement côté serveur)
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# Facultatif (défauts : deepseek-flash, gemini-3.8-flash)
# DEEPSEEK_MODEL=
# GEMINI_MODEL=
# Interrupteur, DÉSACTIVÉ par défaut : l'assistant n'est activé que si la valeur vaut true, 1 ou yes
# (casse et espaces ignorés). Absente, vide, false, 0, off ou toute autre valeur : désactivé (503 ai_disabled).
# AI_GENERATION_ENABLED=true
# Plafond global de générations par jour (UTC), tous clients confondus. Défaut : 100
# AI_DAILY_LIMIT=
# Échéance globale d'une génération en millisecondes (504 ai_timeout au-delà). Défaut : 90000
# AI_REQUEST_DEADLINE_MS=

# Signature HMAC des webhooks
WEBHOOK_SIGNING_SECRET=change-moi
# Webhooks (A2) : destination de test en attendant A5 (projects.webhook_url) ; vide = aucun envoi.
# WEBHOOK_TEST_URL=
# Développement local uniquement : "true" autorise les IP privées (localhost...). Ignoré si NODE_ENV=production.
# WEBHOOK_ALLOW_PRIVATE=

# --- Base de données (packages/db) ---
# DATABASE_URL est construite par docker-compose.yml à partir de POSTGRES_* : rien à ajouter ici en production.
# En local hors Docker : DATABASE_URL=postgres://<user>:<mdp>@127.0.0.1:<port>/<base>

# --- Authentification (C2, Better Auth) : à remplir AVANT la fusion de C2 ---
# Généré une fois : openssl rand -base64 32. Ne jamais le changer en production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://app.hifrica.site
# Application OAuth GitHub, retour : https://app.hifrica.site/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Secrets de webhook par projet, chiffrés AES-256-GCM (C2 chiffre, A5 déchiffre) ---
# Format : v1:<base64 de 32 octets>, plusieurs clés séparées par des virgules, la première chiffre.
# Générer : echo "v1:$(openssl rand -base64 32)". Jamais en base ; sauvegarder à part des dumps SQL.
WEBHOOK_SECRET_KEYS=
