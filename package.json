{
  "name": "hifrica",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @hifrica/api dev",
    "dev:engine": "pnpm --filter @hifrica/engine dev",
    "dev:web": "pnpm --filter @hifrica/web dev",
    "db:generate": "pnpm --filter @hifrica/db db:generate",
    "db:check": "pnpm --filter @hifrica/db db:check",
    "test:db": "pnpm --filter @hifrica/db test",
    "test:db:pg": "pnpm --filter @hifrica/db test:pg",
    "licenses:check": "node scripts/check-licenses.mjs",
    "licenses:md": "node scripts/generate-licenses.mjs",
    "licenses:md:check": "node scripts/generate-licenses.mjs --check"
  }
}
